# Copiar a ".env" y completar con valores reales. ".env" NUNCA se sube al repo.
# Convencion ASP.NET Core: ":" en appsettings.json  ->  "__" en variable de entorno.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

ConnectionStrings__MainDb=Server=HOST;Database=NOMBRE_DB;User Id=USUARIO;Password=CONTRASENA;TrustServerCertificate=True;
ConnectionStrings__AuthDb=Server=HOST;Database=NOMBRE_DB;User Id=USUARIO;Password=CONTRASENA;TrustServerCertificate=True;

Jwt__Key=CAMBIAR_POR_UNA_CLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES
Jwt__Issuer=Dsw2025Tpi.Api
Jwt__Audience=Dsw2025Tpi.Client

AdminUser__Username=Admin
AdminUser__Email=admin@tudominio.com
AdminUser__Password=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# Swagger esta habilitado por defecto en appsettings.json (Swagger:Enabled=true).
# Esta variable permite apagarlo en un entorno real sin tocar el codigo.
Swagger__Enabled=true
